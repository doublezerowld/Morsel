{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "morsel",
  "version": "0.1.0",
  "identifier": "com.sp2fox.morsel",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://0.0.0.0:5173/",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "morsel",
        "width": 1080,
        "height": 2400,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources" : {
      "../data/knowledge.db": "knowledge.db"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
